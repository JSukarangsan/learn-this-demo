{
  "_comment": "Values live here, not in prose. Prose about tokens is wrong within a month.",
  "color": {
    "brand-600": "#2C5CE6",
    "brand-700": "#1F41A8",
    "danger-600": "#C1332B",
    "surface": "#FFFFFF",
    "surface-sunk": "#F4F5F7",
    "text": "#1A1C1F",
    "text-muted": "#5A6169"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32 },
  "radius": { "sm": 4, "md": 8, "pill": 999 },
  "breakpoint": { "min": 320, "sm": 480, "md": 768, "lg": 1024 },
  "component": {
    "button-primary": {
      "background": "brand-600",
      "min-height": 44,
      "never-use-for": "destructive actions — use danger-600 outline instead"
    },
    "session-card": {
      "min-height": 88,
      "must-show": ["cohort timezone", "instructor name"],
      "note": "timezone is per-cohort, never per-learner"
    }
  }
}
